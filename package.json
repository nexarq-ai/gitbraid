{
  "name": "gitbraid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types",
    "deploy": "node scripts/deploy-self-hosted.mjs",
    "deploy:preview": "wrangler deploy --config wrangler.preview.jsonc",
    "setup:self-hosted": "node scripts/install-self-hosted.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@cloudflare/sandbox": "1.0.0",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@phosphor-icons/react": "2.1.10",
    "agents": "0.28.0",
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261012.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "@modelcontextprotocol/client": "2.3.1"
    }
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_EMAIL": {
        "description": "Email address of the initial administrator. Use this with the administrator password to sign in, then enroll MFA."
      },
      "ADMIN_PASSWORD": {
        "description": "Strong unique initial administrator password of at least 12 characters. Kept as a Worker secret. No setup token is required."
      },
      "AI_GATEWAY_ID": {
        "description": "Deployment creates or reuses gateway gitflare. Build credentials need AI Gateway Read/Write and Artifacts Read/Edit. Configure provider BYOK or Unified Billing in Cloudflare dashboard, then enable compatible models in workspace AI models settings."
      }
    }
  }
}
