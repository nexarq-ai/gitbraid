{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitbraid",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/signin",
      "/signup",
      "/api/*",
      "/mcp",
      "/oauth/*",
      "/.well-known/*",
      "/llms.txt",
      "/robots.txt",
      "/connectors",
      "/git/*"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "EDITION": "self-hosted",
    "WORKSPACE_NAME": "Gitbraid workspace",
    "AI_GATEWAY_ID": "gitflare",
    "MODEL": "openai/gpt-6-luna",
    "AI_FEATURES": "enabled",
    "GITBRAID_INSTALLATION": "gitbraid",
    "GITBRAID_PRIMARY_WORKER": "gitbraid"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "MCP_WRITE_RATE_LIMIT",
      "namespace_id": "4101",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "MCP_READ_RATE_LIMIT",
      "namespace_id": "4102",
      "simple": {
        "limit": 100,
        "period": 10
      }
    },
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "4103",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GITFLARE_COORDINATOR",
        "class_name": "GitflareCoordinator"
      },
      {
        "name": "SANDBOX",
        "class_name": "AgentSandbox"
      },
      {
        "name": "GITFLARE_SECURITY",
        "class_name": "GitflareSecurity"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GitflareCoordinator",
        "AgentSandbox"
      ]
    },
    {
      "tag": "v2-security",
      "new_sqlite_classes": [
        "GitflareSecurity"
      ]
    }
  ],
  "workflows": [
    {
      "name": "gitbraid-missions",
      "binding": "MISSION_WORKFLOW",
      "class_name": "MissionWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "gitbraid"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "containers": [
    {
      "name": "gitbraid-runner",
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "tools": {
          "dockerfile": "./runner/Dockerfile"
        }
      }
    }
  ]
}
